  <ItemGroup><Compile Include="../src/Core/*.cs" Link="Core/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fixtures/studio-cross-projection.json" LogicalName="studio-cross-projection.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fixtures/long-rifle-mcx.json" LogicalName="long-rifle-mcx.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fixtures/category-mcx.json" LogicalName="category-mcx.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fixtures/mcx-backport.json" LogicalName="mcx-backport.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fixtures/m4-m870-backport.json" LogicalName="m4-m870-backport.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../assets/Animation/family-presentations.json" LogicalName="family-presentations.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../assets/Animation/all-presentations.json" LogicalName="all-presentations.json" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../src/Runtime/ReadAccess.cs" Link="Runtime/ReadAccess.cs" />
    <Compile Include="../src/Runtime/LocalSessionReader.cs" Link="Runtime/LocalSessionReader.cs" />
    <Compile Include="../src/Runtime/NativeSprintReader.cs" Link="Runtime/NativeSprintReader.cs" />
