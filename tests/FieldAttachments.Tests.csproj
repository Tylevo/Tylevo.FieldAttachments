<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(RuntimeTargetFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(RuntimeTargetFramework)' != ''">$(RuntimeTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType><LangVersion>10.0</LangVersion><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
